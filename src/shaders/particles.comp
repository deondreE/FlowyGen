#version 450

layout(local_size_x = 256) in;

struct Particle {
    vec2 pos;
    vec2 vel;
    float age;       // seconds since spawn; negative = waiting to spawn
    float lifetime;
};

layout(std430, set = 0, binding = 0) buffer Particles {
    Particle particles[];
};

layout(push_constant) uniform Push {
    float dt;
    float time;
    uint count;
    uint flags; // bit 0: initialise the whole buffer
} pc;

// Vulkan clip space: +y points DOWN the screen.
const vec2 emitter = vec2(0.0, 0.9);
const float gravity = 1.6;
const float floor_y = 0.97;

uint pcg(uint v) {
    uint s = v * 747796405u + 2891336053u;
    uint w = ((s >> ((s >> 28u) + 4u)) ^ s) * 277803737u;
    return (w >> 22u) ^ w;
}

// Uniform float in [0, 1).
float next(inout uint state) {
    state = pcg(state);
    return float(state >> 8) * (1.0 / 16777216.0);
}

Particle spawn(inout uint rng) {
    Particle p;
    float angle = (next(rng) - 0.5) * 0.9;
    float speed = 1.4 + next(rng) * 0.9;
    p.pos = emitter + vec2((next(rng) - 0.5) * 0.04, 0.0);
    p.vel = vec2(sin(angle), -cos(angle)) * speed;
    p.lifetime = 2.5 + next(rng) * 2.5;
    p.age = 0.0;
    return p;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.count) return;

    uint rng = pcg(i * 9781u + pcg(floatBitsToUint(pc.time)));

    if ((pc.flags & 1u) != 0u) {
        // First frame: park every particle at the emitter with a random start
        // delay so the fountain ramps up instead of firing one big burst.
        Particle p = spawn(rng);
        p.age = -next(rng) * p.lifetime;
        particles[i] = p;
        return;
    }

    Particle p = particles[i];
    p.age += pc.dt;

    if (p.age < 0.0) {
        particles[i] = p; // still waiting
        return;
    }
    if (p.age >= p.lifetime) {
        particles[i] = spawn(rng);
        return;
    }

    // Semi-implicit Euler.
    p.vel.y += gravity * pc.dt;
    p.pos += p.vel * pc.dt;

    if (p.pos.y > floor_y) {
        p.pos.y = floor_y;
        p.vel.y *= -0.45;
        p.vel.x *= 0.8;
    }
    if (abs(p.pos.x) > 1.0) {
        p.pos.x = sign(p.pos.x);
        p.vel.x *= -0.6;
    }

    particles[i] = p;
}

